# Node Environment
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_ORDER_DB=saga_orders
MONGODB_INVENTORY_DB=saga_inventory
MONGODB_PAYMENT_DB=saga_payments

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=saga-checkout
KAFKA_GROUP_ID_PREFIX=saga

# Service Ports
ORDER_SERVICE_PORT=3001
INVENTORY_SERVICE_PORT=3002
PAYMENT_SERVICE_PORT=3003
ORCHESTRATOR_SERVICE_PORT=3004

# Saga Configuration
SAGA_TIMEOUT_MS=30000
SAGA_RETRY_ATTEMPTS=3